# LLM Provider Configuration

# Default provider (options: openai, cloudflare, ollama — qwen/zhipu are
# NOT implemented yet despite being referenced elsewhere; selecting them
# raises a clear error rather than silently running against OpenAI)
LLM_PROVIDER=openai

# OpenAI Configuration (for default provider)
# OPENAI_API_KEY=your_openai_api_key_here

# Cloudflare Workers AI (open-source hosted models — Llama, Mistral, etc.
# — via Cloudflare's OpenAI-compatible endpoint)
# LLM_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_with_workers_ai_permission
# Then set default_model (and/or individual llm_models entries) in
# .zoro/config.json to a Cloudflare model id, e.g. "@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# Ollama Configuration (local model)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=your_ollama_api_key_if_needed

# Instructions:
# 1. Copy this file to .env
# 2. Configure the LLM_PROVIDER and corresponding API keys
# 3. Never commit .env to version control
# LLM Provider Configuration

# Default provider (options: openai, ollama, qwen, zhipu)
LLM_PROVIDER=openai

# OpenAI Configuration (for default provider)
# OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (local model)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=your_ollama_api_key_if_needed

# Qwen Configuration (Alibaba Cloud)
# LLM_PROVIDER=qwen
# QWEN_API_KEY=your_qwen_api_key_here

# Zhipu Configuration (Zhipu AI)
# LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=your_zhipu_api_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Configure the LLM_PROVIDER and corresponding API keys
# 3. Never commit .env to version control